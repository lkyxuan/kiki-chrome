{
  "manifest_version": 3,
  "name": "Kiki Browser",
  "short_name": "Kiki",
  "version": "0.1.5",
  "description": "Lets Kiki on this Mac use this Chrome profile (one account per profile).",
  "minimum_chrome_version": "116",
  "homepage_url": "https://getkiki.ai",
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Kiki", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["debugger", "tabs", "tabGroups", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"]
}
